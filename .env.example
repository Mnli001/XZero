# ─── Project Zero env template ─────────────────────────────
# Copy to .env and fill in. NEVER commit a real .env.

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/xzero.db
CORS_ORIGINS=*

# MT5 bridge (runs on Windows VPS in production; mock mode on Linux)
MT5_MODE=mock
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_TIMEOUT_MS=60000

# AI reasoning (Claude). Empty => deterministic rule-based fallback (advisory only).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk (server-side enforced; env = deploy-time tuning only)
DEFAULT_RISK_PCT=2.0
MAX_RISK_PCT=5.0
CIRCUIT_MAX_CONSEC_LOSSES=2
CIRCUIT_LOCK_HOURS=24
# Dev/test only: allow resetting the circuit breaker via API. MUST be false in prod.
ALLOW_CIRCUIT_RESET=true

# Knowledge base storage
KNOWLEDGE_DIR=./data/knowledge

# Frontend
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_WS_URL=
